ARANGO_PASSWORD=your_password_here
ARANGO_APP_USERNAME=app_user
ARANGO_APP_PASSWORD=your_app_password_here

# ArangoDB database the backend reads/writes (default: world_graph_all).
# arango-init/init-user.js grants the app user access to world_graph_all only.
ARANGO_DB=world_graph_all

# CORS allowed origins (comma-separated)
# Development:
# ALLOWED_ORIGINS=http://localhost:3000
# Production:
# ALLOWED_ORIGINS=https://humansmap.com

# Optional admin and deployment settings
ADMIN_TOKEN=
CONTROL_PLANE_ALLOWED_CIDRS=127.0.0.1/32

# Optional report email delivery
REPORT_EMAIL_TO=
REPORT_SMTP_HOST=
REPORT_SMTP_USER=
REPORT_SMTP_PASSWORD=
