:80 {
	handle /api/images/* {
		uri strip_prefix /api/images
		file_server {
			root /srv/images
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

humansmap.com {
	tls internal
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' ws:; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'"
		-Server
	}

	handle /api/images/* {
		uri strip_prefix /api/images
		header Cache-Control "public, max-age=604800"
		file_server {
			root /srv/images
		}
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
